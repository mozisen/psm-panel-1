{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psm-panel-1",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  // The API and the subscription always reach the Worker; everything else is
  // the panel's pages, built by `npm run build` into web/dist.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sub/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "psm-panel",
      // No database_id: the Deploy to Cloudflare button (or `wrangler deploy`)
      // creates the database, and the Worker creates its own tables.
      "migrations_dir": "migrations","database_id": "626194ed-ef90-4402-91a6-ec83500d8ca9"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (never in this file): ADMIN_PASSWORD (required), TOKEN_KEY (optional)
}
